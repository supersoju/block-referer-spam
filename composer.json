{
    "name": "supersoju/block-referer-spam",
    "description": "Blocks referer/referral spam from accessing your site.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPBlockRefererSpam\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "test": "phpunit"
    }
}
